{
  "compilerOptions": {
    "target": "ES6",
    "lib": ["ES6", "dom"],
    "types": ["cypress", "node"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,

    "ignoreDeprecations": "5.0"
  },
  "include": ["**/*.ts", "cypress/**/*.ts"]
}
